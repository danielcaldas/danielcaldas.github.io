---
import {PandaConfig} from '../config'
const {start, footer} = PandaConfig
---

<footer class="site-foot">
    <div class="site-foot__links">
        {
            footer &&
                footer.map((item) => (
                    <a
                        href={item.url}
                        target={item.url.startsWith('http') ? '_blank' : undefined}
                        rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                        {item.title}
                    </a>
                ))
        }
    </div>
    <div class="site-foot__meta">{start}—{new Date().getFullYear()}</div>
</footer>
