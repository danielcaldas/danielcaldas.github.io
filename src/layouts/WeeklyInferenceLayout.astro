---
import Layout from './Layout.astro'
import {formatDateYMD} from '@utils/format'
import type {PostFrontMatter} from '../type'

interface IssueNav {
    slug: string
    title: string
}

interface Props {
    FrontMatter: PostFrontMatter
    prev?: IssueNav | null
    next?: IssueNav | null
}
const {FrontMatter, prev, next} = Astro.props
const title = FrontMatter.title
---

<Layout title={title} navbar={false}>
    <style is:inline>
        .ai-banner {
            margin-top: 1.75rem;
            padding: 0.7rem 1rem;
            border-left: 2px solid rgb(var(--accent));
            background: rgb(var(--accent-wash) / 0.5);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            line-height: 1.6;
            letter-spacing: 0.02em;
            color: rgb(var(--ink-muted));
        }

        /* citation tooltip */
        .ct {
            position: fixed;
            z-index: 9999;
            display: flex;
            align-items: flex-start;
            gap: 9px;
            max-width: 300px;
            padding: 10px 13px;
            border-radius: 6px;
            background: rgb(var(--ink-strong));
            color: rgb(var(--paper));
            font-family: var(--font-sans);
            font-size: 12.5px;
            line-height: 1.4;
            pointer-events: none;
            opacity: 0;
            box-shadow: 0 6px 24px rgb(0 0 0 / 0.28);
            transition: opacity 0.12s ease;
        }

        .ct.ct-visible {
            opacity: 1;
        }

        .ct-favicon {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            margin-top: 1px;
            border-radius: 3px;
        }

        .ct-favicon[src=''] {
            display: none;
        }

        .ct-title {
            font-weight: 500;
        }

        .ct-domain {
            margin-top: 3px;
            font-family: var(--font-mono);
            font-size: 10.5px;
            opacity: 0.55;
        }
    </style>

    <nav class="pager" style="margin-top: 1.75rem;" aria-label="Issues">
        {prev ? <a href={`/the-weekly-inference/${prev.slug}/`} title={prev.title}>← previous issue</a> : <span />}
        {next ? <a href={`/the-weekly-inference/${next.slug}/`} title={next.title}>next issue →</a> : <span />}
    </nav>

    <header class="entry-header">
        <h1 class="entry-title">{title}</h1>
        <div class="entry-meta">
            <time datetime={FrontMatter.pubDate}>{formatDateYMD(FrontMatter.pubDate)}</time>
        </div>
    </header>

    <p class="ai-banner">This content is 100% AI-generated. No human editing or oversight.</p>

    <article class="prose content dark:prose-invert prose-stone" id="wi-content">
        <slot />
    </article>

    <script>
        document.querySelectorAll('#wi-content a').forEach((a) => {
            if (a.getAttribute('href')?.startsWith('#')) return
            a.setAttribute('target', '_blank')
            a.setAttribute('rel', 'noopener noreferrer')
        })

        if (window.matchMedia('(pointer: fine)').matches) {
            const CITATION_RE = /^\[\d+\]$/

            // Build href → {title, domain} from cited-source anchors (non-[N] text)
            const titleMap = new Map()
            document.querySelectorAll('#wi-content a[href^="http"]').forEach((a) => {
                const text = a.textContent.trim()
                if (CITATION_RE.test(text)) return
                const href = a.getAttribute('href')
                if (!titleMap.has(href)) {
                    try {
                        const domain = new URL(href).hostname.replace(/^www\./, '')
                        titleMap.set(href, {title: text, domain})
                    } catch {}
                }
            })

            // Create single shared tooltip element
            const tt = document.createElement('div')
            tt.className = 'ct'
            tt.innerHTML = `<img class="ct-favicon" alt="" /><div><div class="ct-title"></div><div class="ct-domain"></div></div>`
            document.body.appendChild(tt)

            const faviconEl = tt.querySelector('.ct-favicon')
            const titleEl = tt.querySelector('.ct-title')
            const domainEl = tt.querySelector('.ct-domain')

            let showTimer

            function positionAndShow(anchor, data) {
                titleEl.textContent = data.title
                domainEl.textContent = data.domain
                faviconEl.src = `https://www.google.com/s2/favicons?domain=${data.domain}&sz=32`
                faviconEl.onerror = () => {
                    faviconEl.src = ''
                }

                const rect = anchor.getBoundingClientRect()
                const ttW = 300
                const ttH = 58

                let left = rect.left
                let top = rect.top - ttH - 10

                if (top < 8) top = rect.bottom + 10
                if (left + ttW > window.innerWidth - 8) left = window.innerWidth - ttW - 8
                if (left < 8) left = 8

                tt.style.left = `${left}px`
                tt.style.top = `${top}px`
                tt.classList.add('ct-visible')
            }

            document.querySelectorAll('#wi-content a[href^="http"]').forEach((a) => {
                const data = titleMap.get(a.getAttribute('href'))
                if (!data) return

                a.addEventListener('mouseenter', () => {
                    showTimer = setTimeout(() => positionAndShow(a, data), 250)
                })
                a.addEventListener('mouseleave', () => {
                    clearTimeout(showTimer)
                    tt.classList.remove('ct-visible')
                })
            })
        }
    </script>

    {
        FrontMatter.lastModified && FrontMatter.pubDate !== FrontMatter.lastModified && (
            <div class="entry-footer">last modified {formatDateYMD(FrontMatter.lastModified)}</div>
        )
    }

    <nav class="pager" aria-label="Issues">
        {prev ? <a href={`/the-weekly-inference/${prev.slug}/`} title={prev.title}>← previous issue</a> : <span />}
        {next ? <a href={`/the-weekly-inference/${next.slug}/`} title={next.title}>next issue →</a> : <span />}
    </nav>
</Layout>
