---
import Layout from './Layout.astro'
import {formatDateYMD} from '@utils/format'
import {slugifySpace} from '@utils/format'
import type {PostFrontMatter} from '../type'

interface Props {
    FrontMatter: PostFrontMatter
}
const {FrontMatter} = Astro.props
const title = FrontMatter.title
const tags = FrontMatter.tags ?? []
---

<Layout title={title} navbar={false}>
    <a rel="prefetch" class="nav-back" href="/">← back</a>

    <header class="entry-header">
        <h1 class="entry-title">{title}</h1>
        <div class="entry-meta">
            <time datetime={FrontMatter.pubDate}>{formatDateYMD(FrontMatter.pubDate)}</time>
            {tags.length > 0 && <span class="entry-meta__sep">·</span>}
            {
                tags.map((tag) => (
                    <a class="tag" href={'/tags/' + slugifySpace(tag) + '/'}>
                        #{tag}
                    </a>
                ))
            }
        </div>
    </header>

    <article class="prose content dark:prose-invert prose-stone">
        <slot />
    </article>

    {
        FrontMatter.pubDate !== FrontMatter.lastModified && (
            <div class="entry-footer">last modified {formatDateYMD(FrontMatter.lastModified)}</div>
        )
    }
</Layout>
