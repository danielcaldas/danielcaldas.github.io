---
import {PandaConfig} from '../config'

const {url} = Astro
const {navbar: items} = PandaConfig

const here = url.toString()
const isRootPage = !items.some((item) => here.includes(item.url))
---

<nav class="site-nav" aria-label="Sections">
    <a rel="prefetch" href="/" class="site-nav__link" aria-current={isRootPage ? 'page' : undefined}>posts</a>
    {
        items.map((item) => (
            <a
                rel="prefetch"
                href={item.url}
                class="site-nav__link"
                aria-current={here.includes(item.url) ? 'page' : undefined}
            >
                {item.title}
            </a>
        ))
    }
</nav>
