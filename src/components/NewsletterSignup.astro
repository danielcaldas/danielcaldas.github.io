---
import {PandaConfig} from '../config'

interface Props {
    /** Short line above the form. */
    label?: string
}

const {label = 'Get each issue in your inbox, once a week.'} = Astro.props
const username = PandaConfig.newsletter.buttondownUsername
const action = `https://buttondown.com/api/emails/embed-subscribe/${username}`
---

<section class="newsletter" aria-labelledby="newsletter-label">
    <p id="newsletter-label" class="newsletter__label">{label}</p>
    <form class="newsletter__form embeddable-buttondown-form" action={action} method="post" target="_blank">
        <input type="hidden" name="embed" value="1" />
        <label class="newsletter__sr" for="bd-email">Email address</label>
        <input
            class="newsletter__input"
            type="email"
            name="email"
            id="bd-email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
        />
        <button class="newsletter__button" type="submit">subscribe</button>
    </form>
    <p class="newsletter__note">
        Double opt-in. Unsubscribe any time. Also available via <a href="/the-weekly-inference/rss.xml">RSS</a>.
    </p>
</section>

<style>
    .newsletter {
        margin: 2rem 0;
        padding: 1.1rem 1.2rem;
        border: 1px solid rgb(var(--rule));
        background: rgb(var(--paper-raised));
    }

    .newsletter__label {
        margin: 0 0 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.02em;
        color: rgb(var(--ink-muted));
    }

    .newsletter__form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .newsletter__input {
        flex: 1 1 15rem;
        min-width: 0;
        padding: 0.5rem 0.65rem;
        border: 1px solid rgb(var(--rule));
        background: rgb(var(--paper));
        color: inherit;
        font-family: var(--font-mono);
        font-size: 0.82rem;
    }

    .newsletter__input:focus-visible {
        outline: 2px solid rgb(var(--accent));
        outline-offset: 1px;
    }

    .newsletter__button {
        padding: 0.5rem 1rem;
        border: 1px solid rgb(var(--accent));
        background: rgb(var(--accent-wash));
        color: inherit;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        letter-spacing: 0.02em;
        cursor: pointer;
    }

    .newsletter__button:hover {
        background: rgb(var(--accent) / 0.25);
    }

    .newsletter__note {
        margin: 0.7rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        line-height: 1.6;
        color: rgb(var(--ink-muted));
    }

    .newsletter__sr {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
