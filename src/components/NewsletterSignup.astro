---
import {PandaConfig} from '../config'

interface Props {
    /** Compact variant for the end of an issue. */
    variant?: 'index' | 'issue'
}

const {variant = 'index'} = Astro.props
const {buttondownUsername} = PandaConfig.newsletter
const action = `https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`
const id = `wi-email-${variant}`
---

<section class:list={['newsletter', `newsletter--${variant}`]} aria-labelledby={`${id}-label`}>
    <p class="newsletter__label" id={`${id}-label`}>
        {variant === 'index' ? 'get every issue in your inbox' : 'liked this issue? get the next one in your inbox'}
    </p>
    <form class="newsletter__form" action={action} method="post" target="_blank">
        <label class="newsletter__sr" for={id}>email address</label>
        <input
            class="newsletter__input"
            type="email"
            name="email"
            id={id}
            placeholder="you@example.com"
            autocomplete="email"
            required
        />
        <input type="hidden" name="embed" value="1" />
        <button class="newsletter__button" type="submit">subscribe</button>
    </form>
    <p class="newsletter__fine">Free. One email a week. Unsubscribe anytime.</p>
</section>
