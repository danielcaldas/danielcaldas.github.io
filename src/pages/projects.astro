---
import Layout from '@layouts/Layout.astro'
export const prerender = true
---

<Layout title="projects">
    <h1 class="page-title">projects</h1>
    <p class="page-lede">Things I built, and things I have since put down.</p>

    <div class="prose content dark:prose-invert prose-stone">
        <h2>🏃‍♂️‍➡️ tweak</h2>

        <p><a href="https://tweak-extension.com/">tweak-extension.com</a></p>

        <p>
            Mock or modify your HTTP requests to test, develop and demo your web application. tweak allows you to mock
            and modify HTTP requests without leaving the browser.
        </p>

        <h2>🪦 react-d3-graph</h2>

        <p>
            <a href="https://github.com/danielcaldas/react-d3-graph">github.com/danielcaldas/react-d3-graph</a> — no longer
            maintaining it, but it's still widely used.
        </p>

        <p>Interactive and configurable graphs with react and d3 effortlessly.</p>

        <h2>🪦 clipflow</h2>

        <p><em>clipflow.ai (sold domain)</em></p>

        <p>The content clipper that highlights and syncs content, with opt-in AI enhancements.</p>
    </div>
</Layout>
