---
import Layout from '@layouts/Layout.astro'
export const prerender = true

interface Entry {
    date: string
    title: string
    url: string
    /** Trailing context, rendered muted after the title. */
    note?: string
    noteUrl?: {label: string; url: string}
    noteAfter?: string
}

const sections: {heading: string; entries: Entry[]}[] = [
    {
        heading: 'writing',
        entries: [
            {
                date: '2024',
                title: 'Under the hood: leveraging AI for smart insights in Typeform',
                url: 'https://medium.com/typeforms-engineering-blog/under-the-hood-leveraging-ai-for-smart-insights-in-typeform-74cf6f35d929',
                note: "on Typeform's engineering blog",
            },
            {
                date: '2022',
                title: 'A Comparison of E2E JavaScript Testing Frameworks',
                url: 'https://tweak-extension.com/blog/comparison-e2e-javascript-testing-frameworks',
                note: 'featured in',
                noteUrl: {label: 'Software Testing Weekly #138', url: 'https://softwaretestingweekly.com/issues/138'},
            },
            {
                date: '2021',
                title: 'Best Puppeteer Tips',
                url: 'https://tweak-extension.com/blog/best-puppeteer-tips',
                note: 'featured in',
                noteUrl: {label: 'Software Testing Weekly #97', url: 'https://softwaretestingweekly.com/issues/97/'},
            },
            {
                date: '2021',
                title: 'A guide to custom React hooks with MutationObserver',
                url: 'https://blog.logrocket.com/guide-to-custom-react-hooks-with-mutationobserver/',
                note: 'guest post on',
                noteUrl: {label: "LogRocket's blog", url: 'https://blog.logrocket.com/author/danielcaldas/'},
            },
            {
                date: '2020',
                title: 'A Hands-On Introduction to Reactive Programming with RxJS',
                url: 'https://danielcaldas.github.io/posts/hands-on-reactive-programming-rxjs/',
                note: 'featured in',
                noteUrl: {label: 'JavaScript Weekly #506', url: 'https://javascriptweekly.com/issues/506'},
            },
            {
                date: '2020',
                title: 'Tips for End to End Testing with Puppeteer',
                url: 'https://danielcaldas.github.io/posts/tips-end-to-end-testing-puppeteer/',
                note: 'featured in',
                noteUrl: {label: 'JavaScript Weekly #493', url: 'https://javascriptweekly.com/issues/493'},
            },
            {
                date: '2019',
                title: 'Quick Tips for Using Mocks when Unit Testing with Jest',
                url: 'https://danielcaldas.github.io/posts/tips-jest-unit-testing/',
                note: 'featured in',
                noteUrl: {label: 'JavaScript Weekly #448', url: 'https://javascriptweekly.com/issues/448'},
            },
            {
                date: '2019',
                title: 'Generating image URLs at build time',
                url: 'https://tech.trivago.com/post/2019-04-02-babelplugincloudinary',
                note: 'a joint release with',
                noteUrl: {label: 'babel-plugin-cloudinary', url: 'https://github.com/trivago/babel-plugin-cloudinary'},
                noteAfter: 'on the trivago tech blog',
            },
        ],
    },
    {
        heading: 'podcasts',
        entries: [
            {
                date: '2020',
                title: 'MJS 142: Daniel Caldas',
                url: 'https://podcasts.apple.com/in/podcast/mjs-142-daniel-caldas/id1237399540?i=1000469336493&l=or',
                note: 'my JavaScript story, on My JavaScript Story',
            },
            {
                date: '2019',
                title: 'JSJ 411: Unit Testing JavaScript with Jest',
                url: 'https://topenddevs.com/podcasts/javascript-jabber/jsj-411-unit-testing-jest-with-daniel-caldas',
                note: 'guest on the JavaScript Jabber podcast',
            },
        ],
    },
    {
        heading: 'papers',
        entries: [
            {
                date: '2017',
                title: 'Socii: A Tool to Analyze and Visualize Dynamic Social Networks',
                url: 'https://repositorium.uminho.pt/entities/publication/ab8a9084-acc8-48a1-8e54-e638e10b6539',
                note: 'my thesis paper, also featured in',
                noteUrl: {label: 'OASIcs, Volume 56', url: 'https://drops.dagstuhl.de/entities/volume/OASIcs-volume-56'},
            },
        ],
    },
]
---

<Layout title="spotlight">
    <h1 class="page-title">spotlight</h1>
    <p class="page-lede">External work: guest posts, features, podcasts and papers.</p>

    <div class="archive">
        {
            sections.map((section) => (
                <section class="archive__group">
                    <h2 class="archive__year">{section.heading}</h2>
                    <ul class="archive__list">
                        {section.entries.map((entry) => (
                            <li class="archive__item archive__item--stacked">
                                <span class="archive__date">{entry.date}</span>
                                <span>
                                    <a
                                        class="archive__link"
                                        href={entry.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {entry.title}
                                    </a>
                                    {entry.note && (
                                        <span class="archive__note">
                                            {entry.note}
                                            {entry.noteUrl && (
                                                <>
                                                    {' '}
                                                    <a
                                                        href={entry.noteUrl.url}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {entry.noteUrl.label}
                                                    </a>
                                                </>
                                            )}
                                            {entry.noteAfter && <> {entry.noteAfter}</>}
                                        </span>
                                    )}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</Layout>
